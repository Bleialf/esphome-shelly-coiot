# Nach secrets.yaml kopieren und ausfuellen. secrets.yaml ist in .gitignore
# und gehoert NICHT ins Repo -- hier stehen echte Schluessel drin.

# WLAN am Standort des Shelly
wifi_ssid: "SSID"
wifi_password: "WLAN-PASSWORT"
fallback_password: "fallback1234"

# WireGuard, aus der wg-Client-Config uebernommen
wg_private_key: "PrivateKey aus [Interface]"
wg_peer_public_key: "PublicKey aus [Peer]"
wg_preshared_key: "PresharedKey aus [Peer]"

# ESPHome -- erzeugen mit: openssl rand -base64 32
api_encryption_key: "BASE64-32-BYTE-KEY"
ota_password: "OTA-PASSWORT"
